# Copy this file to .env and fill in your own private values.
# Never commit .env, MongoDB passwords or your Admin key.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=wedding_video_maker
ADMIN_API_KEY=<generate-at-least-24-random-characters>

# Optional Cloudinary video storage: add your real values in private .env,
# then restart the rendering server. Never put API_SECRET in VITE_* or HTML.
# When these three settings are absent, existing MongoDB GridFS storage is used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RENDER_HOST=127.0.0.1
RENDER_PORT=4174
FRONTEND_ORIGIN=http://localhost:5173
